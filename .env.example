VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.
# VITE_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Vercel Function values. Never prefix these with VITE_.
# Generate 32 random bytes and encode as 64 hexadecimal characters.
ADMIN_ACCESS_KEY=
# Generate a separate 32 random bytes and encode as 64 hexadecimal characters.
# Used to HMAC client addresses for the persistent admin lockout table.
ADMIN_SESSION_SECRET=
# Server-only; never expose this key to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=